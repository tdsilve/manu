{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd api && .venv/bin/uvicorn manu.main:app --port 8000"],
      "port": 8000
    }
  ]
}
