# Copie para .env e ajuste. O .env nunca vai para o git.

# Caminhos locais (ignorados pelo git, ver ADR 0006)
MANU_REGISTRY=data/manuals.yaml
MANU_PDF_DIR=data/pdfs
MANU_CHROMA_DIR=data/chroma

# Embeddings. O modelo precisa ser multilíngue: manuais e perguntas estão em
# português. Trocar o provedor ou o modelo exige recriar a base (apague
# MANU_CHROMA_DIR, ou use outra database no Chroma Cloud, e rode manu-index).
#   ollama: local, sem custo (padrão: bge-m3)
#   voyage: hospedado, usado no deploy (padrão: voyage-3.5)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=
OLLAMA_URL=http://localhost:11434
VOYAGE_API_KEY=

# Chroma Cloud. Com CHROMA_API_KEY definida, a base fica na nuvem e
# MANU_CHROMA_DIR é ignorado.
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Busca
TOP_K=3
# Provisório: recalibrar com a avaliação (ticket 09)
SIMILARITY_THRESHOLD=0.5

# Geração (Claude). Nunca coloque a chave real aqui, só no .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Origem da interface web (CORS). Várias origens: separe por vírgula.
CORS_ORIGIN=http://localhost:3000
