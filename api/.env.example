# Copie para .env e ajuste. O .env nunca vai para o git.

# Caminhos locais (ignorados pelo git, ver ADR 0006)
MANU_REGISTRY=data/manuals.yaml
MANU_PDF_DIR=data/pdfs
MANU_CHROMA_DIR=data/chroma

# Embeddings locais (Ollama). O modelo precisa ser multilíngue: manuais e
# perguntas estão em português. Trocar o modelo exige recriar a base
# (apague MANU_CHROMA_DIR e rode manu-index).
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Busca
TOP_K=3
# Provisório: recalibrar com a avaliação (ticket 09)
SIMILARITY_THRESHOLD=0.5

# Geração (Claude). Nunca coloque a chave real aqui, só no .env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Origem da interface web (CORS)
CORS_ORIGIN=http://localhost:3000
